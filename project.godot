; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="interchange"
run/main_scene="uid://cotl3pepw3h8a"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

RoadGraph="*uid://0kp1norpbk46"
LaneGraph="*uid://dci64qqh8ukn8"
ArcOverrides="*uid://djm5edq15p388"

[debug]

gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/defaults/default_clear_color=Color(0.3, 0.3, 0.3, 1)

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.101960786, 0.10980392, 0.13333334, 1)
